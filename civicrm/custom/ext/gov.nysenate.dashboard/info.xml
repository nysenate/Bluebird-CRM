  <name>NYSS: Dashboard</name>
  <description>Customizes the CiviCRM dashboard for Bluebird CRM.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Lighthouse Consulting and Design, Inc.</author>
    <email>brian@lcdservices.biz</email>
  </maintainer>
  <urls>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2019-08-22</releaseDate>
  <version>1.0</version>
  <develStage>stable</develStage>
  <compatibility>
