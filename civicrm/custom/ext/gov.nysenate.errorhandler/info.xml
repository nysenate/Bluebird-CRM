<?xml version="1.0"?>
<extension key="gov.nysenate.errorhandler" type="module">
  <file>errorhandler</file>
  <name>NYSS: Error Handler</name>
  <description>Provides a custom fatal error handling callback for Bluebird CRM.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Lighthouse Consulting and Design, Inc.</author>
    <email>dev@lcdservices.biz</email>
  </maintainer>
  <urls>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2022-03-08</releaseDate>
  <version>1.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments/>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
  <civix>
    <namespace>CRM/NYSS/Errorhandler</namespace>
    <angularModule>crmErrorhandler</angularModule>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
