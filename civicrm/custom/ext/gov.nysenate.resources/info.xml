<?xml version="1.0"?>
<extension key="gov.nysenate.resources" type="module">
  <file>resources</file>
  <name>NYSS: Resources</name>
  <description>Used to register custom resources, such as js libraries, css, etc.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>NYS Senate</author>
    <email>brian@lcdservices.biz</email>
  </maintainer>
  <urls>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2017-01-11</releaseDate>
  <version>1.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.16</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/NYSS/Resources</namespace>
    <format>26.10.3</format>
  </civix>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
</extension>
