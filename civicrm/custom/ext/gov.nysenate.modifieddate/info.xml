<?xml version="1.0"?>
<extension key="gov.nysenate.modifieddate" type="module">
  <file>modifieddate</file>
  <name>NYSS: Modified Date Triggers</name>
  <description>Defines additional triggers to track contact modified date from related records.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>NYS Senate</author>
    <email>brian@lcdservices.biz</email>
  </maintainer>
  <urls>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2018-02-17</releaseDate>
  <version>1.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/NYSS/ModifiedDate</namespace>
    <format>25.10.2</format>
  </civix>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
