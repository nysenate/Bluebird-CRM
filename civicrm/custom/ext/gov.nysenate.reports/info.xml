<?xml version="1.0"?>
<extension key="gov.nysenate.reports" type="module">
  <file>reports</file>
  <name>NYSS: Reports</name>
  <description>Provides New York State Senate customizations for CiviReport templates and queries.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>NYS Senate</author>
    <email>brian@lcdservices.biz</email>
  </maintainer>
  <urls>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2018-06-25</releaseDate>
  <version>1.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.27</ver>
  </compatibility>
  <comments>Note: there is a Drupal module handling report modifications as well. Eventually all customizations should be migrated to this extension.</comments>
  <civix>
    <namespace>CRM/NYSS/Reports</namespace>
    <format>25.01.1</format>
  </civix>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>mgd-php@1.0.0</mixin>
    <mixin>ang-php@1.0.0</mixin>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
  </mixins>
</extension>
