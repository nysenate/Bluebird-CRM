<?xml version="1.0"?>
<extension key="gov.nysenate.dedupe" type="module">
  <file>dedupe</file>
  <name>NYSS: Dedupe</name>
  <description>Provides custom deduplication rules and shadow tables for Bluebird CRM.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>NYS Senate</author>
    <email>brian@lcdservices.biz</email>
  </maintainer>
  <urls>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2024-11-26</releaseDate>
  <version>1.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.75</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/NYSS/Dedupe</namespace>
    <format>25.10.2</format>
  </civix>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
