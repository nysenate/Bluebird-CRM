<?xml version="1.0"?>
<extension key="gov.nysenate.mail" type="module">
  <file>mail</file>
  <name>NYSS: Mailing Customizations</name>
  <description/>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>NYSS Senate</author>
    <email>brian@lcdservices.biz</email>
  </maintainer>
  <urls>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2017-05-23</releaseDate>
  <version>1.3</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.55</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/NYSS/Mail</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>ang-php@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-admin@1.0.1</mixin>
    <mixin>setting-php@1.0.0</mixin>
  </mixins>
  <requires>
    <ext>uk.co.vedaconsulting.mosaico</ext>
  </requires>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Mail\AutomaticUpgrader</upgrader>
</extension>
