<?php

// NYSS 5581
function nyss_mail_custom_theme() {
  $allowedPaths = [
    'civicrm/nyss/subscription/manage',
    'civicrm/nyss/subscription/view',
    'civicrm/nyss/subscription/expired',
  ];

  if (in_array($_GET['q'], $allowedPaths)) {
    return 'BluebirdPublic';
  }
  else {
    return null;
  }
}
